nano api-deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
spec:
  replicas: 1

  selector:
    matchLabels:
      app: api

  template:
    metadata:
      labels:
        app: api

    spec:
      containers:
        - name: api
          image: mecaniqa-api:latest

          ports:
            - containerPort: 8080

nano api-service.yaml

apiVersion: v1
kind: Service
metadata:
  name: api
spec:
  type: NodePort

  selector:
    app: api

  ports:
    - protocol: TCP
      port: 8080
      targetPort: 8080

nano mysql-deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: mysql
spec:
  replicas: 1

  selector:
    matchLabels:
      app: mysql

  template:
    metadata:
      labels:
        app: mysql

    spec:
      containers:
        - name: mysql
          image: mysql:8.0

          ports:
            - containerPort: 3306

          env:
            - name: MYSQL_ROOT_PASSWORD
              value: root

            - name: MYSQL_DATABASE
              value: mecaniqa

            - name: MYSQL_USER
              value: mecaniqa

            - name: MYSQL_PASSWORD
              value: mecaniqa


nano mysql-service.yaml

apiVersion: v1
kind: Service
metadata:
  name: db
spec:
  type: ClusterIP

  selector:
    app: mysql

  ports:
    - protocol: TCP
      port: 3306
      targetPort: 3306

